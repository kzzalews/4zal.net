---
import { UI, SITE, type Lang } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-200/60 dark:border-zinc-800/60">
  <div class="max-w-3xl mx-auto px-6 py-8 text-sm text-zinc-500 dark:text-zinc-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <p>{t['footer.tagline']}</p>
    <p class="font-mono text-xs">
      © {year} {SITE.author.name} · {t['footer.copyright']}
    </p>
  </div>
</footer>
