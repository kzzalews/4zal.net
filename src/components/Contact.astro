---
import { UI, SITE, type Lang } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];

// Kontakty (EN defaults; PL uses same links)
const contacts = [
  {
    label: t['contact.cta.email'],
    href: SITE.author.email,
    icon: 'mail',
    external: false,
  },
  {
    label: t['contact.cta.mastodon'],
    href: 'https://mastodon.social/@kzzalews',
    icon: 'mastodon',
    external: true,
  },
  {
    label: t['contact.cta.github'],
    href: 'https://github.com/kzzalews',
    icon: 'github',
    external: true,
  },
  {
    label: t['contact.cta.pgp'],
    href: SITE.author.pgpKeyUrl,
    icon: 'key',
    external: false,
    fingerprint: SITE.author.pgpFingerprint,
  },
];
---

<section id="contact" class="max-w-3xl mx-auto px-6 py-16 sm:py-20 scroll-mt-20">
  <p class="font-mono text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-500 mb-3">
    → /contact
  </p>
  <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
    {t['contact.title']}
  </h2>
  <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
    {t['contact.lead']}
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {contacts.map((c) => (
      <li>
        <a
          href={c.href}
          target={c.external ? '_blank' : undefined}
          rel={c.external ? 'me noopener noreferrer' : 'me'}
          class="group block p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
        >
          <div class="flex items-center justify-between">
            <span class="font-medium text-zinc-900 dark:text-zinc-100">
              {c.label}
            </span>
            <svg class="w-4 h-4 text-zinc-400 group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          <p class="mt-1 text-xs font-mono text-zinc-500 dark:text-zinc-500 truncate">
            {c.href.replace(/^mailto:/, '').replace(/^https?:\/\//, '')}
          </p>
          {c.fingerprint && (
            <p class="mt-1 text-[10px] font-mono text-zinc-400 dark:text-zinc-600 uppercase tracking-wider">
              {c.fingerprint.match(/.{1,4}/g)?.join(' ')}
            </p>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
