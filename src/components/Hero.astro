---
import { UI, SITE, type Lang } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
---

<section class="max-w-3xl mx-auto px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
  <p class="font-mono text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-500 mb-3">
    → /home
  </p>
  <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
    {t['hero.greeting']}
  </h1>
  <p class="mt-5 text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
    {t['hero.role']}
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={lang === 'pl' ? '/pl/#about' : '/#about'}
      class="inline-flex items-center px-4 py-2 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-sm font-medium hover:bg-zinc-700 dark:hover:bg-zinc-300 transition-colors"
    >
      {t['hero.cta.about']}
      <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
    <a
      href={lang === 'pl' ? '/pl/#contact' : '/#contact'}
      class="inline-flex items-center px-4 py-2 rounded-md border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 text-sm font-medium hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
    >
      {t['hero.cta.contact']}
    </a>
  </div>
</section>
