---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="404 — Not Found">
  <section class="max-w-3xl mx-auto px-6 py-24 sm:py-32">
    <p class="font-mono text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-500 mb-3">
      → /404
    </p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight">404</h1>
    <p class="mt-4 text-xl text-zinc-600 dark:text-zinc-400">
      This page doesn’t exist. At least, not anymore.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center px-4 py-2 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-sm font-medium hover:bg-zinc-700 dark:hover:bg-zinc-300 transition-colors"
    >
      Back home
    </a>
  </section>
</BaseLayout>
